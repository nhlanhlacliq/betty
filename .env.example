# Copy to .env and fill in. Both are optional.
# Anything VITE_-prefixed is baked into the public JS bundle: private personal deployment only.

# Claude API key (console.anthropic.com). Without it Betty uses fallback phrases.
VITE_ANTHROPIC_API_KEY=

# TomTom Traffic key (developer.tomtom.com). Without it traffic is simulator-only.
VITE_TOMTOM_API_KEY=
