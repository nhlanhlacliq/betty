# Copy to .env for LOCAL development. All optional.
#
# Local (npm run dev): the page calls Claude and TomTom directly with these. VITE_ values are baked into the page,
# which is why the DEPLOYED app does not use them.
VITE_ANTHROPIC_API_KEY=
VITE_TOMTOM_API_KEY=

# Deployed (Vercel production env, NOT VITE_, so they stay on the server and never reach the page):
#   ANTHROPIC_API_KEY   used by api/phrase.ts
#   TOMTOM_API_KEY      used by api/traffic.ts
#   GROQ_API_KEY        used by api/transcribe.ts (talking to Betty; free key from console.groq.com)
#   VITE_USE_SERVER=1   tells the page to go through those functions
